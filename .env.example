# Copia este archivo como .env.development.local (npm run dev) y .env.production.local
# (npm run build). Ninguno se sube a GitHub. Rellena los valores de cada entorno.

# Quién comprueba el login: supabase (Google y correo), api (Python, carpeta backend/) o demo
# (cuentas de prueba de src/auth/demoAccounts.ts). Vacío = api si hay VITE_API_URL; si no, demo.
VITE_AUTH_PROVIDER=

# Origen de los cursos: local (copia en src/data/trainingCatalogData.ts) o supabase.
VITE_TRAINING_SOURCE=local

# API en Python (carpeta backend/). Vacío = ofertas y conexiones guardadas solo en este navegador.
VITE_API_URL=

# Supabase Studio → Project Settings → API (o "Data API" / "API Keys").

# Project URL, p. ej. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Clave pública: "anon public" o "publishable" (empieza por eyJ... o sb_publishable_...).
# NUNCA pongas aquí la service_role / secret: acabaría publicada en la web.
VITE_SUPABASE_ANON_KEY=
